# Runtime
WORKBENCH_ENV=local

# Local PostgreSQL
POSTGRES_DB=workbench
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=

# Java API
JAVA_API_PORT=8080
JAVA_API_BASE_URL=http://localhost:8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/workbench
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Python RAG API
PYTHON_RAG_PORT=8000
PYTHON_RAG_BASE_URL=http://localhost:8000

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Local storage
WORKBENCH_DATA_DIR=./data

# Offline hash vectors (no model download or API key required)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Local document chunk sizing
RAG_CHUNK_MAX_TOKENS=420

# Optional interview generation (backend only)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional public GitHub API authentication (backend only)
GITHUB_TOKEN=
